# Copie para .env.local (não versionado).

# Proxy de saída nos EUA. Sem isso o eFD do Senado costuma responder 403.
# OUTBOUND_PROXY_URL=http://user:pass@gate.us.provider.com:10000
OUTBOUND_PROXY_URL=

# Postgres local do docker-compose, ou qualquer outra URL.
DATABASE_URL=postgres://finance:finance@localhost:5434/finance_shot

BACKEND_PORT=4000

# Tentativas de uma etapa antes de FAILED.
WORKFLOW_MAX_ATTEMPTS=3

# true encadeia etapas aprovadas na subida. O backfill de 3 anos começa sozinho.
WORKFLOW_AUTORUN=false

# Pausa entre páginas de relatório do Senado, em milissegundos.
SENATE_REQUEST_DELAY_MS=1000
