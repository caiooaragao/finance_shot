# Copie para .env.local (não versionado).

# Proxy de saída nos EUA. Sem isso o eFD do Senado costuma responder 403.
# OUTBOUND_PROXY_URL=http://user:pass@gate.us.provider.com:10000
OUTBOUND_PROXY_URL=

# Postgres local do docker-compose, lido pelo Prisma (dev: ./run.sh → porta 5434).
DATABASE_URL=postgresql://finance:finance@localhost:5434/finance_shot

# Deploy (./deploy.sh nesta pasta): banco e app na porta 7000.
# POSTGRES_PORTS=127.0.0.1:7000:5432
# DATABASE_URL=postgresql://finance:finance@127.0.0.1:7000/finance_shot
# APP_PORT=7000

# Destino opcional para ./sync-to-cloud.sh (só no shell; não precisa estar no app).
# CLOUD_DATABASE_URL=postgresql://postgres:senha@db.xxx.supabase.co:5432/postgres

# Tentativas de uma etapa antes de FAILED.
WORKFLOW_MAX_ATTEMPTS=3

# true encadeia etapas aprovadas na subida. O backfill histórico (desde 2012) começa sozinho.
WORKFLOW_AUTORUN=false

# Pausa entre páginas de relatório do Senado, em milissegundos.
SENATE_REQUEST_DELAY_MS=1000
